[
  {
    "namespace": "thunderbirdSkillBridge",
    "description": "Thunderbird Skill CLI Phase 1 本地回环桥",
    "functions": [
      {
        "name": "start",
        "type": "function",
        "async": true,
        "parameters": []
      },
      {
        "name": "getState",
        "type": "function",
        "async": true,
        "parameters": []
      },
      {
        "name": "beginPairing",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "clientId", "type": "string" },
          { "name": "publicKeyAlgorithm", "type": "string", "enum": ["Ed25519"] },
          { "name": "publicKeySpkiBase64", "type": "string" }
        ]
      },
      {
        "name": "confirmPairing",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "intentId", "type": "string" },
          { "name": "code", "type": "string" }
        ]
      },
      {
        "name": "revokePairing",
        "type": "function",
        "async": true,
        "parameters": []
      },
      {
        "name": "listMailRoutes",
        "type": "function",
        "async": true,
        "parameters": [],
        "description": "返回 api.js 内 MAIL_ROUTES 静态表的 route id 列表，供 background 侧自检其 handler 登记表是否与之一致。"
      },
      {
        "name": "respondMailRoute",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "token", "type": "string" },
          { "name": "resultJson", "type": "string" }
        ],
        "description": "background 完成某条邮件 route 的处理后调用，携带 JSON 序列化的成功结果，唤醒 api.js 中挂起的对应请求。"
      },
      {
        "name": "failMailRoute",
        "type": "function",
        "async": true,
        "parameters": [
          { "name": "token", "type": "string" },
          { "name": "errorCode", "type": "string" },
          { "name": "errorMessage", "type": "string" }
        ],
        "description": "background 判定某条邮件 route 请求失败（含未实现）时调用，唤醒 api.js 中挂起的对应请求并以该错误码/信息响应 CLI。"
      }
    ],
    "events": [
      {
        "name": "onMailRouteRequest",
        "type": "function",
        "description": "api.js 完成认证/capability/body 上限校验后，把已授权的邮件 route 请求转发给 background；background 必须调用 respondMailRoute 或 failMailRoute 之一来响应，api.js 本身不解释任何邮件业务语义。",
        "parameters": [
          { "name": "token", "type": "string" },
          { "name": "routeId", "type": "string" },
          { "name": "capability", "type": "string" },
          { "name": "bodyJson", "type": "string" }
        ]
      }
    ]
  }
]
