{
  "manifest_version": 3,
  "name": "Thunderbird Skill Bridge",
  "version": "0.4.0",
  "description": "为本机 thunderbird CLI 提供回环服务、配对与只读/可逆/草稿-外发邮件能力；不申请永久删除或日历权限。真实外发（compose.send）是可选权限，默认未授予、物理无法发送；用户须在扩展 options 页面显式勾选外发确认能力，经浏览器原生权限提示同意后才会真正解锁",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-skill-bridge@local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["dist/background.js"]
  },
  "experiment_apis": {
    "thunderbirdSkillBridge": {
      "schema": "bridge/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["thunderbirdSkillBridge"]],
        "script": "bridge/api.js"
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "messagesMove",
    "compose",
    "compose.save"
  ],
  "optional_permissions": [
    "compose.send"
  ],
  "host_permissions": [],
  "web_accessible_resources": []
}
