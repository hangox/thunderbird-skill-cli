{
  "manifest_version": 3,
  "name": "Thunderbird Skill Bridge",
  "version": "0.2.1",
  "description": "为本机 thunderbird CLI 提供回环服务、配对与只读/可逆/草稿邮件能力；不申请永久删除或日历权限，外发权限（compose.send）留待外发专项评审后的集成阶段单独加入",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-skill-bridge@local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["dist/background.js"]
  },
  "experiment_apis": {
    "thunderbirdSkillBridge": {
      "schema": "bridge/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["thunderbirdSkillBridge"]],
        "script": "bridge/api.js"
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "messagesMove",
    "compose",
    "compose.save"
  ],
  "host_permissions": [],
  "web_accessible_resources": []
}
